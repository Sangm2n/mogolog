<?xml version="1.0" encoding="utf-8"?>
<!-- 시험 카드 한 장 (시험 고르기 목록, 기록 탭 목록에서 같이 씀) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 시험 이름 -->
        <TextView
            android:id="@+id/exam_card_name"
            style="@style/TextBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="2027학년도 9월 모의평가" />

        <!-- 종류 배지 (평가원, 교육청, 사설) -->
        <TextView
            android:id="@+id/exam_card_type"
            style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_kice"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/badge_kice_text"
            tools:text="평가원" />
    </LinearLayout>

    <!-- 날짜 (기록 탭에서는 과목별 점수) -->
    <TextView
        android:id="@+id/exam_card_detail"
        style="@style/TextBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        tools:text="2026.09.02" />
</LinearLayout>