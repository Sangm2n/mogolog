<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exam_list_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/screen_padding"
    tools:context=".ExamListFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/exam_list_title"
            style="@style/TextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_exam_list" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/exam_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_16"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            android:visibility="gone" />

        <!-- 성적이 하나도 없을 때 -->
        <TextView
            android:id="@+id/exam_list_empty"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/exam_list_empty"
            android:textColor="@color/text_sub" />
    </LinearLayout>

    <!-- + 버튼 -->
    <Button
        android:id="@+id/exam_list_add"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:includeFontPadding="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="28sp"
        app:backgroundTint="@null" />

</FrameLayout>