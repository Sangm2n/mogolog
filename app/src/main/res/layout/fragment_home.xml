<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_title"
                style="@style/TextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_home" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/home_notifications"
                style="@style/ScreenAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="0dp"
                android:text="@string/home_notifications"
                android:textColor="@color/text_sub"
                android:textStyle="normal" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/home_next_exam_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/home_exam_card_min_height"
            android:background="@drawable/bg_card_primary"
            android:padding="@dimen/space_16">

            <TextView
                android:id="@+id/home_next_exam_label"
                style="@style/TextLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:text="@string/home_next_exam"
                android:textColor="@color/badge_kice_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/home_next_exam_badge"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/home_next_exam_badge"
                style="@style/ScreenBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/value_placeholder"
                android:textColor="@color/primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="교육청" />

            <TextView
                android:id="@+id/home_next_exam_name"
                style="@style/TextExamTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_12"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/home_exam_placeholder"
                android:textColor="@color/card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/home_next_exam_day_count"
                app:layout_constraintTop_toBottomOf="@id/home_next_exam_badge"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="10월 전국연합학력평가" />

            <TextView
                android:id="@+id/home_next_exam_day_count"
                style="@style/TextMetric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/value_placeholder"
                android:textSize="@dimen/text_size_day_count"
                android:textColor="@color/card"
                app:layout_constraintTop_toBottomOf="@id/home_next_exam_badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="D-5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/home_review_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_8"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_unreviewed_label"
                        android:textColor="@color/text_sub" />

                    <TextView
                        android:id="@+id/home_unreviewed_count"
                        style="@style/TextMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/error"
                        tools:text="8개" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/home_review_action"
                    style="@style/ScreenAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/home_review_action" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/home_review_progress_label"
                    style="@style/TextCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_review_progress_label" />

                <TextView
                    android:id="@+id/home_review_progress_value"
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_placeholder"
                    android:textColor="@color/primary"
                    tools:text="79%" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/home_review_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/review_progress_height"
                android:layout_marginTop="@dimen/space_8"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_review"
                android:progressTint="@null"
                android:progressBackgroundTint="@null"
                android:importantForAccessibility="no"
                tools:progress="79" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_recent_exam_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_recent_exam" />

                <TextView
                    android:id="@+id/home_recent_exam_name"
                    style="@style/TextCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/value_placeholder"
                    tools:text="2026 9월 모의평가" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_recent_scores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/HomeScoreTile">

                    <TextView
                        android:id="@+id/home_korean_subject"
                        style="@style/TextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subject_korean_label" />

                    <TextView
                        android:id="@+id/home_korean_score"
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_placeholder"
                        tools:text="78" />

                </LinearLayout>

                <LinearLayout style="@style/HomeScoreTile">

                    <TextView
                        android:id="@+id/home_math_subject"
                        style="@style/TextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subject_math_label" />

                    <TextView
                        android:id="@+id/home_math_score"
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_placeholder"
                        tools:text="84" />

                </LinearLayout>

                <LinearLayout style="@style/HomeScoreTile">

                    <TextView
                        android:id="@+id/home_english_subject"
                        style="@style/TextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subject_english_label" />

                    <TextView
                        android:id="@+id/home_english_score"
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_placeholder"
                        tools:text="88" />

                </LinearLayout>

                <LinearLayout style="@style/HomeScoreTile">

                    <TextView
                        android:id="@+id/home_inquiry_subject"
                        style="@style/TextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subject_inquiry_label"
                        tools:text="생명 Ⅰ" />

                    <TextView
                        android:id="@+id/home_inquiry_score"
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_placeholder"
                        tools:text="41" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/home_score_trend" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="로그아웃" />

        <TextView
            android:id="@+id/home_data_status"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/text_sub"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/home_data_retry"
                style="@style/ScreenAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_retry"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/home_demo_action"
                style="@style/ScreenAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_demo_enable"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>