<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".ExamInputActivity">

    <!-- 상단 바: 취소 / 제목 / 저장 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/exam_input_cancel"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:text="‹ 취소"
            android:textColor="@color/text_sub" />

        <TextView
            style="@style/TextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="성적 입력" />

        <TextView
            android:id="@+id/exam_input_save"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:text="저장"
            android:textColor="@color/primary"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 내용: 펼침/접힘 때 아래가 부드럽게 밀리도록 animateLayoutChanges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- 고른 시험 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/exam_input_exam_name"
                style="@style/TextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="2027학년도 9월 모의평가" />

            <TextView
                android:id="@+id/exam_input_exam_detail"
                style="@style/TextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                tools:text="평가원 · 2026.09.02" />
        </LinearLayout>

        <!-- 선택과목: 평소엔 한 줄 요약, "변경"을 누르면 펼침 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선택과목"
                    android:textColor="@color/text_sub" />

                <TextView
                    android:id="@+id/exam_input_elective_summary"
                    style="@style/TextBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textSize="12sp"
                    tools:text="언어와매체 · 미적분 · 생명과학1, 지구과학1" />

                <TextView
                    android:id="@+id/exam_input_elective_toggle"
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="변경"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <!-- 펼쳤을 때만 보이는 부분 -->
            <LinearLayout
                android:id="@+id/exam_input_elective_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 국어: tag = 저장할 이름 (띄어쓰기 없음) -->
                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="국어" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/exam_input_korean_eonmae"
                        style="@style/ExamInputChip"
                        android:tag="언어와매체"
                        android:text="언어와 매체" />

                    <CheckBox
                        android:id="@+id/exam_input_korean_hwajak"
                        style="@style/ExamInputChip"
                        android:tag="화법과작문"
                        android:text="화법과 작문" />
                </LinearLayout>

                <!-- 수학 -->
                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="수학" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/exam_input_math_hwaktong"
                        style="@style/ExamInputChip"
                        android:tag="확률과통계"
                        android:text="확률과 통계" />

                    <CheckBox
                        android:id="@+id/exam_input_math_mijeok"
                        style="@style/ExamInputChip"
                        android:tag="미적분"
                        android:text="미적분" />

                    <CheckBox
                        android:id="@+id/exam_input_math_giha"
                        style="@style/ExamInputChip"
                        android:tag="기하"
                        android:text="기하" />
                </LinearLayout>

                <!-- 탐구 2과목: 과학 한 줄, 사회 한 줄 (칩은 코드에서) -->
                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="탐구 (2과목)" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextLabel"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="과학" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/exam_input_science_recycler"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_exam_input_chip" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextLabel"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="사회" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/exam_input_social_recycler"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_exam_input_chip" />
                </LinearLayout>

                <TextView
                    android:id="@+id/exam_input_save_default"
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="이 선택을 기본값으로 저장"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 과목: 칩은 코드에서 추가 -->
        <TextView
            style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="과목"
            android:textColor="@color/text_sub" />

        <GridLayout
            android:id="@+id/exam_input_subject_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="4" />

        <!-- 원점수 · 등급 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원점수"
                android:textColor="@color/text_sub" />

            <TextView
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="필수"
                android:textColor="@color/error" />

            <EditText
                android:id="@+id/exam_input_raw_score"
                style="@style/TextBody"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="0~100"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="등급"
                android:textColor="@color/text_sub" />

            <EditText
                android:id="@+id/exam_input_grade"
                style="@style/TextBody"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="선택"
                android:inputType="number"
                android:maxLength="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- 틀린 문항 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="틀린 문항"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exam_input_wrong_count"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0개 선택됨"
                android:textColor="@color/error" />
        </LinearLayout>

        <!-- 예: 23~30번: 미적분 / 과목을 먼저 골라 주세요 -->
        <TextView
            android:id="@+id/exam_input_elective_hint"
            style="@style/TextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 번호 칸: 여기만 스크롤 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/exam_input_wrong_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:padding="8dp"
            tools:itemCount="30"
            tools:listitem="@layout/item_wrong_number" />
    </LinearLayout>
</LinearLayout>