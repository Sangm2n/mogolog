<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextCardTitle" parent="TextBody">
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextExamTitle" parent="TextTitle">
        <item name="android:textSize">@dimen/text_size_card_title</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextMetric" parent="TextTitle">
        <item name="android:textSize">@dimen/text_size_value</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextCaption" parent="TextLabel">
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="ScreenAction" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextBody</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="ScreenBadge" parent="TextLabel">
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">@dimen/space_8</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
        <item name="android:paddingTop">@dimen/space_4</item>
        <item name="android:paddingBottom">@dimen/space_4</item>
    </style>
    <style name="HomeScoreTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/home_score_tile_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/space_8</item>
        <item name="android:paddingBottom">@dimen/space_8</item>
        <item name="android:background">@drawable/bg_card_muted</item>
    </style>
    <style name="HomeTrendSubject" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">@drawable/bg_home_trend_subject</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:paddingStart">@dimen/space_8</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
        <item name="android:textAppearance">@style/TextLabel</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>
</resources>
